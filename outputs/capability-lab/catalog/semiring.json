  {
    "id": "semiring.add",
    "title": "Semiring sum of two matrices",
    "description": "Combine two weighted graphs on the same nodes entry by entry with the semiring's ⊕ (or, +, min, max or union): two alternative routes become one entry.",
    "kind": "atomic",
    "dependsOn": [],
    "inputSchema": {
      "type": "object",
      "properties": {
        "semiring": {
          "type": "string",
