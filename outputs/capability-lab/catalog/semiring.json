            }
          ]
        }
      },
      {
        "input": {
          "semiring": "counting",
          "size": 2,
          "left": [
            {
              "from": 0,
              "to": 1,
              "weight": 2
            }
          ],
          "right": [
            {
              "from": 0,
              "to": 1,
              "weight": 3
            }
          ]
        },
        "expected": {
          "sum": [
            {
              "from": 0,
              "to": 1,
              "weight": 5
            }
          ]
        }
      },
      {
        "input": {
          "semiring": "lineage",
