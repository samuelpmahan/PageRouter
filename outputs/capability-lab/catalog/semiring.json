              },
              "weight": {
                "type": "number"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "semiring",
        "size",
        "left",
        "right"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "sum": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              },
              "weight": {
                "type": "number"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sum"
      ],
      "additionalProperties": false
    },
    "formula": "(L ⊕ R)[i][j] = L[i][j] ⊕ R[i][j]; an absent entry is the semiring zero",
    "caveats": [
      "Matrices are edge lists; an absent entry is zero (false, 0, +∞, 0 or no lineage).",
      "An entry may appear once per matrix."
    ],
    "examples": [
      {
        "input": {
          "semiring": "tropical",
          "size": 2,
          "left": [
            {
              "from": 0,
              "to": 1,
              "weight": 5
            }
          ],
          "right": [
            {
              "from": 0,
              "to": 1,
              "weight": 3
            },
            {
              "from": 1,
              "to": 0,
              "weight": 2
            }
          ]
        },
        "expected": {
          "sum": [
