[
  {
    "id": "composed.covarianceMatrix",
    "title": "Sample covariance matrix",
    "description": "Build a symmetric feature-by-feature covariance matrix from observations stored in rows.",
    "kind": "composed",
    "dependsOn": [
      "linalg.transpose",
      "statistics.covariance"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "denominator": {
          "type": "string",
          "enum": [
            "sample",
            "population"
          ]
        }
      },
      "required": [
        "observations"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "matrix"
      ],
      "additionalProperties": false
    },
    "examples": [
      {
        "input": {
          "observations": [
            [
              -2,
              0
            ],
            [
              -1,
              0
            ],
            [
              1,
              0
            ],
            [
              2,
              0
            ],
            [
              0,
              -1
            ],
            [
              0,
              1
            ]
          ],
          "denominator": "sample"
        },
        "expected": {
          "matrix": [
            [
              2,
              0
            ],
            [
              0,
              0.4
            ]
          ]
        }
      }
    ],
    "formula": "Cᵢⱼ = Cov(Xᵢ, Xⱼ), with the selected population n or sample n−1 denominator.",
    "caveats": "Requires at least two observations and a rectangular matrix. The default denominator is sample. Covariance is undefined for a singleton."
  },
  {
    "id": "composed.principalComponents",
    "title": "Principal component directions",
    "description": "Compose the covariance matrix with a symmetric eigensolver to rank principal directions.",
    "kind": "composed",
    "dependsOn": [
      "composed.covarianceMatrix",
      "linalg.symmetricEigen"
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "denominator": {
          "type": "string",
          "enum": [
            "sample",
            "population"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9999999999999999
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "observations"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "covarianceMatrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "eigenvalues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "eigenvectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "iterations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "covarianceMatrix",
        "eigenvalues",
        "eigenvectors",
        "iterations"
      ],
      "additionalProperties": false
    },
    "examples": [
      {
        "input": {
          "observations": [
            [
              -2,
              0
            ],
            [
              -1,
              0
            ],
            [
              1,
              0
            ],
            [
              2,
              0
            ],
            [
              0,
              -1
            ],
            [
              0,
              1
            ]
          ],
          "denominator": "sample"
        },
        "expected": {
          "covarianceMatrix": [
            [
              2,
              0
            ],
            [
              0,
              0.4
            ]
          ],
          "eigenvalues": [
            2,
            0.4
          ],
          "eigenvectors": [
            [
              1,
              0
            ],
            [
              0,
              1
            ]
          ],
          "iterations": 0
        }
      }
    ],
    "formula": "C V = V Λ; eigenvectors are columns, ordered by descending eigenvalue.",
    "caveats": "Uses the selected covariance denominator. A nonconverged eigensystem fails; eigenvector signs may differ while describing the same axis."
  },
