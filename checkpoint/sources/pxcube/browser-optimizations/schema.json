{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxcube.local/schema/browser-optimization-store.v1.json",
  "title": "PxCube Browser Optimization Store",
  "description": "A small, advisory registry of repeatable browser/runtime slow-path patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storeId", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "storeId": { "const": "pxcube-browser-optimizations" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "status", "scope", "tags", "problem", "signals",
        "recommendation", "guard", "appliesTo", "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^BO-[0-9]{4}$" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["seeded", "active", "retired"] },
        "scope": { "enum": ["browser-runtime", "local-development", "all-experiences"] },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "minItems": 1 },
        "problem": { "$ref": "#/$defs/nonEmpty" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "observation"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "event": { "$ref": "#/$defs/nonEmpty" },
              "observation": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "actions", "avoid"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmpty" },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "minItems": 1 },
            "avoid": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assertion", "testRef"],
          "properties": {
            "kind": { "enum": ["static", "unit", "browser"] },
            "assertion": { "$ref": "#/$defs/nonEmpty" },
            "testRef": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lanes", "surfaces"],
          "properties": {
            "lanes": { "type": "array", "items": { "enum": ["neat", "tidy", "crisp"] }, "minItems": 1 },
            "surfaces": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "minItems": 1 }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref", "note"],
            "properties": {
              "kind": { "enum": ["local-observation", "unit-test", "browser-test", "design-note"] },
              "ref": { "$ref": "#/$defs/nonEmpty" },
              "note": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "increments", "unit", "verification"],
            "properties": {
              "kind": { "const": "crop-correction-strip" },
              "increments": {
                "type": "array",
                "const": [-10, -5, -3, -1, 1, 3, 5, 10],
                "minItems": 8,
                "maxItems": 8,
                "uniqueItems": true
              },
              "unit": { "const": "selection-diameter-percentage-points" },
              "verification": { "const": "same-viewport" }
            }
          }
        }
      }
    }
  }
}
