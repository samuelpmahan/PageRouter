+    assert.equal(fs.readFileSync(path.join(source, '.emit-tmp/sentinel'), 'utf8'), 'preexisting compiler work');
+    assert.equal(fs.readFileSync(path.join(source, 'tsconfig.emit.json'), 'utf8'), 'preexisting config');
