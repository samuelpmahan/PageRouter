+  fs.mkdirSync(path.join(source, '.emit-tmp'));
+  fs.writeFileSync(path.join(source, '.emit-tmp/sentinel'), 'preexisting compiler work');
+  fs.writeFileSync(path.join(source, 'tsconfig.emit.json'), 'preexisting config');
+  const seed = (file, data) => { const p = path.join(target, file); fs.mkdirSync(path.dirname(p), { recursive: true }); fs.writeFileSync(p, data); };
+  seed('sources/pxcube/vendor/studio/part-first-kernel/src/pxc.mjs', fs.readFileSync(path.join(ROOT, 'packages/pxc/src/pxc.mjs')));
+  seed('exp/policybench/cli/args.mjs', 'old helper\n');
+  seed('exp/policybench/cli/unrelated.mjs', 'keep unrelated CLI\n');
+  seed('exp/policybench/core/keep.mjs', 'keep unrelated generated output\n');
+  seed('exp/policybench/README.md', 'keep native README\n');
+  seed('exp/policybench/native.test.mjs', 'keep native tests\n');
+  const emit = (...args) => spawnSync(process.execPath, ['tools/emit-pagerouter.mjs', target, ...args], { cwd: source, encoding: 'utf8' });
