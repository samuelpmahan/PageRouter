+  const { flagReader } = await import(pathToFileURL(file));
+  const rows = [
+    [[], 'seed', 'demo', 'demo'], [['--seed'], 'seed', 'demo', 'demo'],
+    [['--seed', ''], 'seed', 'demo', ''], [['--seed', '-5'], 'seed', 'demo', '-5'],
+    [['--seed', '--rules'], 'seed', 'demo', '--rules'], [['--seed=7'], 'seed', 'demo', 'demo'],
+    [['--seed', '1', '--seed', '2'], 'seed', 'demo', '1'], [['--', '--seed', '7'], 'seed', 'demo', '7'],
+    [['--seeds', '9'], 'seed', 'demo', 'demo'], [['--Seed', '9'], 'seed', 'demo', 'demo'],
+  ];
+  for (const [argv, key, fallback, answer] of rows) assert.equal(flagReader(argv)(key, fallback), answer);
+  const fallback = { budget: 1 };
+  assert.equal(flagReader([])('seed', fallback), fallback);
+  assert.equal(flagReader([])('seed'), undefined);
+  assert.equal(flagReader(['--seed'])('seed', null), null);
