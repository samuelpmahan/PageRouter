+  assert.deepEqual(Object.keys(after).filter(f => !(f in before)).sort(), allowed.filter(f => !(f in before)).sort());
+  for (const name of CONSUMERS) assert.ok(after[`exp/policybench/cli/${name}.mjs`]);
+  assert.notEqual(after['exp/policybench/cli/args.mjs'], before['exp/policybench/cli/args.mjs'], 'replace the old helper');
+  const { flagReader } = await import(pathToFileURL(path.join(target, 'exp/policybench/cli/args.mjs')));
+  assert.equal(flagReader(['--seed', '7'])('seed', 'demo'), '7');
+  assert.equal(flagReader(['--seed'])('seed', 'demo'), 'demo');
+  const full = emit();
+  assert.equal(full.status, 0, full.stdout + full.stderr);
+  const fullFiles = snapshot(target);
+  for (const file of allowed) assert.equal(after[file], fullFiles[file], `${file}: bounded and full payloads match`);
