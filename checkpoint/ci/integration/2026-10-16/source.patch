+const snapshot = dir => Object.fromEntries(fs.readdirSync(dir, { recursive: true, withFileTypes: true })
+  .filter(e => e.isFile()).map(e => { const p = path.join(e.parentPath, e.name); return [path.relative(dir, p), fs.readFileSync(p).toString('base64')]; }).sort(([a], [b]) => a.localeCompare(b)));
+function fixture(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'pb-emitter-test-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const source = path.join(dir, 'source'), target = path.join(dir, 'checkpoint');
+  fs.cpSync(ROOT, source, { recursive: true, filter: p => !['node_modules', '.emit-tmp', 'tsconfig.emit.json'].includes(path.basename(p)) && !path.basename(p).startsWith('.emit-') });
