{
  "domain": "statistics",
  "capabilities": [
    {
      "id": "statistics.mean",
      "title": "Arithmetic mean",
      "description": "The central average of a nonempty finite sample.",
      "kind": "atomic",
      "dependsOn": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "input": {
            "values": [
              1,
              2,
              3
            ]
          },
          "expected": {
            "value": 2
          }
        }
      ],
      "formula": "sum(xᵢ / n), using compensated summation.",
      "caveats": ""
    },
    {
      "id": "statistics.variance",
      "title": "Variance",
      "description": "Population or sample spread, computed with Welford updates to reduce cancellation.",
      "kind": "atomic",
      "dependsOn": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "denominator": {
            "type": "string",
            "enum": [
              "population",
              "sample"
            ]
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "input": {
            "values": [
              1,
              2,
              3
            ],
            "denominator": "population"
          },
          "expected": {
            "value": 0.6666666666666666
          }
        }
      ],
      "formula": "M₂ / n for population variance; M₂ / (n - 1) for sample variance.",
      "caveats": "Sample variance requires at least two values; population variance accepts one."
    },
    {
      "id": "statistics.weightedMean",
      "title": "Weighted mean",
      "description": "Average with nonnegative weights and a positive total weight.",
      "kind": "atomic",
      "dependsOn": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          }
        },
        "required": [
          "values",
          "weights"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "input": {
            "values": [
              1,
              3,
              10
            ],
            "weights": [
              1,
              2,
              1
            ]
          },
          "expected": {
            "value": 4.25
          }
        }
      ],
      "formula": "Σ(wᵢxᵢ) / Σwᵢ; weights are scaled before summing.",
      "caveats": ""
    },
    {
      "id": "statistics.weightedVariance",
      "title": "Weighted population variance",
      "description": "Spread around the weighted mean using a population denominator.",
