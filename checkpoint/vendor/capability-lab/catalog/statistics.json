            ]
          },
          "expected": {
            "value": 11.6875
          }
        }
      ],
      "formula": "Σ(wᵢ(xᵢ - μw)²) / Σwᵢ; weighted mean is obtained through the declared dependency.",
      "caveats": "This is a population-weighted variance. Reliability-weight sample corrections are not applied."
    },
    {
      "id": "statistics.onlineUpdate",
      "title": "Online moment update",
      "description": "Add one observation to a retained count, mean, and M₂ state without storing past values.",
      "kind": "atomic",
      "dependsOn": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "mean": {
                "type": "number"
              },
              "m2": {
                "type": "number",
                "minimum": 0
              },
              "variance": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "count",
              "mean",
              "m2"
            ],
            "additionalProperties": false
          },
          "value": {
            "type": "number"
          },
          "denominator": {
            "type": "string",
            "enum": [
              "population",
              "sample"
            ]
          }
        },
        "required": [
          "state",
          "value"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "mean": {
            "type": "number"
          },
          "m2": {
            "type": "number",
            "minimum": 0
          },
          "variance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "count",
          "mean",
          "m2",
          "variance"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "input": {
            "state": {
              "count": 0,
              "mean": 0,
              "m2": 0
            },
            "value": 5
          },
          "expected": {
            "count": 1,
            "mean": 5,
            "m2": 0,
            "variance": 0
          }
        }
      ],
      "formula": "Welford update: δ = x - μ; μ′ = μ + δ/n′; M₂′ = M₂ + δ(x - μ′).",
      "caveats": "The empty state is explicitly {count: 0, mean: 0, m2: 0}. A returned variance may be passed back as optional derived metadata; it is validated, ignored, and recomputed from count/mean/m2. Sample variance is undefined until the count reaches two."
    },
    {
      "id": "statistics.onlineMoments",
