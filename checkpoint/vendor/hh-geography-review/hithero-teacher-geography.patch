+def test_approved_teacher_cannot_create_profile_in_another_district(site):
+    module, client, _ = site
+    register(client)
+    login(client)
+    assert approve(client).status_code == 200
+    # Model the live schema's possible createCount=0 default explicitly; the
+    # baseline ORM does not declare it. This isolates the authorization defect.
+    with module.SessionLocal() as db:
+        user = db.execute(select(module.RegisteredUsers).where(
+            module.RegisteredUsers.email == "teacher@example.test")).scalar_one()
+        user.createCount = 0
+        db.commit()
+    login(client, "teacher@example.test")
+    response = profile(client, district="District B", school="School B")
+    assert response.status_code == 403, response.text
+    with module.SessionLocal() as db:
+        assert db.execute(select(module.TeacherList)).first() is None
+
+
+def approved_teacher(site, make_profile=True):
+    module, client, _ = site
+    register(client)
+    login(client)
+    assert approve(client).status_code == 200
+    login(client, "teacher@example.test")
+    if make_profile:
+        assert profile(client).status_code == 200
+    with module.SessionLocal() as db:
+        return db.execute(select(module.RegisteredUsers).where(
+            module.RegisteredUsers.email == "teacher@example.test")).scalar_one().id
+
