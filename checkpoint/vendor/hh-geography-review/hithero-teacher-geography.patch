--- /dev/null
+++ b/migrations/20261017_teacher_geography_approvals.sql
@@ -0,0 +1,30 @@
+-- Owner-reviewed Azure SQL migration. Run before deploying the application.
+-- Do not backfill from teacher_list: those locations were user-editable.
+SET XACT_ABORT ON;
+BEGIN TRANSACTION;
+
+IF OBJECT_ID(N'dbo.teacher_geography_approvals', N'U') IS NULL
+BEGIN
+    CREATE TABLE dbo.teacher_geography_approvals (
+        id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
+        user_id INT NOT NULL,
+        state NVARCHAR(255) NOT NULL,
+        county NVARCHAR(255) NOT NULL,
+        district NVARCHAR(255) NOT NULL,
+        school NVARCHAR(255) NOT NULL,
+        approved_by INT NOT NULL,
+        approved_at DATETIME NOT NULL,
+        CONSTRAINT FK_teacher_geography_approvals_user
+            FOREIGN KEY (user_id) REFERENCES dbo.registered_users(id) ON DELETE CASCADE
+    );
+END;
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE object_id = OBJECT_ID(N'dbo.teacher_geography_approvals')
+      AND name = N'ix_teacher_geography_approvals_user_id'
+)
+    CREATE INDEX ix_teacher_geography_approvals_user_id
+        ON dbo.teacher_geography_approvals(user_id);
+
+COMMIT TRANSACTION;
