+    ddl = str(CreateTable(module.TeacherGeographyApproval.__table__).compile(dialect=mssql.dialect()))
+    assert "NVARCHAR(255)" in ddl
+    assert "IDENTITY" in ddl
+    assert "ON DELETE CASCADE" in ddl
+    query = select(module.RegisteredUsers).with_hint(
