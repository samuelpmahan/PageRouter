+def test_same_district_approval_retains_registration_scope(site):
+    module, client, _ = site
+    teacher_id = approved_teacher(site)
+    register(client, "colleague@example.test", school="Another School")
+    assert approve(client, "colleague@example.test").status_code == 200
+    with module.SessionLocal() as db:
+        user = db.execute(select(module.RegisteredUsers).where(
+            module.RegisteredUsers.email == "colleague@example.test")).scalar_one()
+        approval = db.execute(select(module.TeacherGeographyApproval).where(
+            module.TeacherGeographyApproval.user_id == user.id)).scalar_one()
+        assert (approval.state, approval.county, approval.district, approval.school) == (
+            "Test State", "Test County", "District A", "Another School")
+        assert approval.approved_by == teacher_id
+        assert user.createCount == 0
+        assert db.execute(select(module.NewUsers)).first() is None
