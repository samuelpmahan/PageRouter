       const url = new URL(value);
       return url.protocol === 'https:' && url.hostname === 'www.amazon.com' && !url.username && !url.password &&
         !url.search && !url.hash && /^\/hz\/wishlist\/ls\/DEMO(?:-[A-Z0-9]+)+$/.test(url.pathname);
     } catch { return false; }
