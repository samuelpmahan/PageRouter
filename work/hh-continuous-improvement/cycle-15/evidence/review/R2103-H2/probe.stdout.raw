        },
        "registrationEmail": "",
        "contactEmail": ""
      }
    },
    "serviceCalls": [
      {
        "port": "SchoolData.getStates",
        "inputKeys": []
      }
    ],
    "serviceCallCount": 1,
    "runtimeReceiptCount": 2
  },
  "afterInput": {
