    "pxcube-create-graphics": {
      "version": "0.1.0",
      "root": "experiences/create-graphics",
      "clean": "clean",
      "experiments": "exp",
      "tests": [
        "node --test local/test/demo-experiences.test.mjs",
        "node local/test/demo-experiences-browser.mjs"
      ],
      "experience": {
        "title": "CreateGraphics",
        "description": "Make a DiscSpotlight with real specimen Parts and the shared card renderer.",
        "entry": "index.html",
        "mounts": [
          "studio"
        ],
        "build": "node build.mjs",
        "outDir": "dist",
        "sandbox": [
          "allow-scripts",
          "allow-same-origin",
          "allow-downloads",
          "allow-modals",
          "allow-forms"
        ],
        "demo": {
          "mode": "create"
        },
        "criticalJourney": {
          "contract": "OTOV2/#PROcision",
          "scenarios": [
            "typical",
            "mobile"
          ],
          "start": {
            "selector": "#purpose-spotlight"
          },
          "initial": {
            "selector": "[data-create-step=\"choose\"]",
            "attribute": "aria-selected",
            "value": "true"
          },
          "activePanelSelector": "[data-create-panel].is-active",
          "viewports": [
            "desktop",
            "mobile"
          ],
          "actions": {
            "desktop": [
              {
                "action": "click",
                "selector": "#compare-cards",
                "expect": "#card-study[open]"
              }
            ],
            "mobile": [
              {
                "action": "click",
                "selector": "[data-create-step=\"verify\"]",
                "attribute": "aria-selected",
                "value": "true"
              },
              {
                "action": "click",
                "selector": "[data-create-step=\"finish\"]",
                "attribute": "aria-selected",
                "value": "true"
              },
              {
                "action": "click",
                "selector": "[data-create-step=\"choose\"]",
                "attribute": "aria-selected",
                "value": "true"
              }
            ]
          }
        },
        "track": "exp"
      }
    },
